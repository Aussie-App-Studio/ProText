{
  "manifest_version": 3,
  "name": "ProText for Google Messages™: Themes, Folders & Undo",
  "short_name": "ProText",
  "version": "0.1.0",
  "description": "Themes, smart folder tabs, undo send buffer, schedule send, contact CRM notes, and productivity power tools for Google Messages for Web.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://messages.google.com/web/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ProText for Google Messages™",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://messages.google.com/web/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
